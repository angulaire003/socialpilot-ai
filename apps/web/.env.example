# Clé API pour la génération IA (OpenAI ou compatible)
# Sans cette clé, un générateur de secours local est utilisé.
OPENAI_API_KEY=sk-...

# Optionnel : endpoint compatible OpenAI (ex: xAI Grok, Azure, etc.)
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_MODEL=grok-beta

# Alternative possible
# GROK_API_KEY=...
